@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thực hành CSS - Định dạng bảng</title>
    <style>
        /* ===== Ví dụ 1 ===== */
        table.mytable {
            border-collapse: collapse;
            border: 3px solid black;
        }

        th.mytable {
            border: 1px solid black;
            background: DodgerBlue;
            font-weight: bold;
            color: white;
        }

        td.mytable {
            border: 1px solid black;
            text-align: center;
        }

        tr.mytable_row1 {
            background-color: LightBlue;
        }

        tr.mytable_row2 {
            background-color: LightCyan;
        }

        /* ===== Ví dụ 2 ===== */
        table.mytable2 {
            border-collapse: collapse;
        }

        th.mytable2 {
            border-top: 3px solid black;
            border-bottom: 2px solid black;
            background: violet;
            font-weight: bold;
            color: white;
            text-align: left;
        }

        td.mytable2_column1 {
            background-color: gainsboro;
        }

        tr.mytable2 {
            border-bottom: 3px solid black;
            border-top: 2px solid black;
        }
    </style>
</head>
<body>
    <h2>THỰC HÀNH CSS - ĐỊNH DẠNG BẢNG</h2>
    <hr />

    <h3>Ví dụ 1: Định dạng bảng</h3>
    <table class="mytable">
        <tr>
            <th class="mytable" width="150">header 1</th>
            <th class="mytable" width="150">header 2</th>
            <th class="mytable" width="150">header 3</th>
        </tr>
        <tr class="mytable_row1">
            <td class="mytable">column 1</td>
            <td class="mytable">column 2</td>
            <td class="mytable">column 3</td>
        </tr>
        <tr class="mytable_row2">
            <td class="mytable">column 1</td>
            <td class="mytable">column 2</td>
            <td class="mytable">column 3</td>
        </tr>
        <tr class="mytable_row1">
            <td class="mytable">column 1</td>
            <td class="mytable">column 2</td>
            <td class="mytable">column 3</td>
        </tr>
        <tr class="mytable_row2">
            <td class="mytable">column 1</td>
            <td class="mytable">column 2</td>
            <td class="mytable">column 3</td>
        </tr>
    </table>

    <br /><br />

    <h3>Ví dụ 2: Định dạng bảng</h3>
    <table class="mytable2">
        <tr>
            <th class="mytable2" width="150">header 1</th>
            <th class="mytable2" width="150">header 2</th>
            <th class="mytable2" width="150">header 3</th>
        </tr>
        <tr>
            <td class="mytable2_column1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>
        <tr>
            <td class="mytable2_column1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>
        <tr class="mytable2">
            <td class="mytable2_column1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>
    </table>
</body>
</html>
